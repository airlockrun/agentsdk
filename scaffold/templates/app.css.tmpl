/* Tailwind v4 + DaisyUI v5 source. The build pipeline runs
 *   .airlock/toolchain/bin/tailwindcss -i styles/app.css -o views/static/app.css --minify
 * and the compiled output is embedded into the agent and served at
 * /static/app.{hash}.css. Theming: see AGENTS.md.
 */

@import "tailwindcss";

@plugin "../.airlock/toolchain/lib/tailwind/daisyui.mjs" {
  themes: light --default, dark --prefersdark;
}
