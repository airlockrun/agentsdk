# A local go.work you create for your own multi-module editing is ignored
# so it never lands in a push. Airlock's builds resolve libs via GOPROXY,
# not go.work, so committing one wouldn't affect them anyway.
go.work
go.work.sum

# Tailwind build output — regenerated by the Docker build's templ + tailwindcss
# step. styles/app.css (the source) IS committed; this is only the artifact.
views/static/app.css

# templ output — regenerated from committed .templ source before each build.
*_templ.go

# sqlc output — regenerated from committed migrations and query SQL before each
# build. internal/db/doc.go is the tracked package anchor.
internal/db/db.go
internal/db/models.go
internal/db/*.sql.go

# Local Airlock runtime state: storage, caches, and other developer-machine data.
.airlock/local/

# Repo-local frontend toolchain and coding skills installed by
# `go tool air toolchain install`.
.airlock/toolchain/
