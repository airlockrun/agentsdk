package main

import (
	"context"
	"net/http"
	"net/http/httptest"
	"testing"

	"agent/views"

	"github.com/airlockrun/agentsdk/agenttest"
)

// TestAgentComposition exercises the routes and static declarations wired by
// newAgent through the real SDK mux. Handler behavior has package-local tests.
func TestAgentComposition(t *testing.T) {
	env := agenttest.New(t, newAgent)
	srv := httptest.NewServer(env.Agent.Handler())
	defer srv.Close()

	for _, path := range []string{"/", views.AppCSSPath} {
		resp, err := http.Get(srv.URL + path)
		if err != nil {
			t.Fatalf("GET %s: %v", path, err)
		}
		resp.Body.Close()
		if resp.StatusCode != http.StatusOK {
			t.Errorf("GET %s = %d, want %d", path, resp.StatusCode, http.StatusOK)
		}
	}
}

// TestDBMigratesAndConnects is the worked example for DB-backed tests.
// agenttest.New uses TEST_DB_URL when supplied or starts pgvector with Docker.
// agentsdk.New resets and applies db/migrations before newAgent constructs
// dependencies or registrations. Once you add tables, query through Agent.DB()
// and assert on the results; this run checks that the migrated pool is reachable.
func TestDBMigratesAndConnects(t *testing.T) {
	env := agenttest.New(t, newAgent)
	if err := env.Agent.DB().PingContext(context.Background()); err != nil {
		t.Fatalf("agent DB not reachable after migrate: %v", err)
	}
}
