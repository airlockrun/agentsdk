package main

import (
	"agent/handlers"
	"agent/views"
	"agent/welcome"

	"github.com/airlockrun/agentsdk"
	"github.com/airlockrun/goai/tool"
)

func main() {
	newAgent().Serve()
}

// newAgent defines the complete agent and wires late-bound SDK handles into its
// dependencies. It must not read runtime environment, query the database, make
// network calls, or start goroutines: Airlock also invokes this definition
// offline to obtain the manifest. Runtime startup, DB and authenticated HTTP
// integration execute on a real Airlock preview. Keep this separate from main.
func newAgent() *agentsdk.Agent {
	agent := agentsdk.New(agentsdk.Config{
		Description: "New agent — update this description after implementation",
		Icon:        "📦", // Choose an emoji that represents this app.
	})
	words := welcome.New(agent.DB(), agent.RegisterUIChangeTopic("welcome"))
	pages := handlers.New(words)
	agent.RegisterTool(tool.Typed[welcome.SetWordInput, welcome.WordOutput]("set_welcome_word").
		Description("Set your welcome word").Execute(words.SetWordTool).Build(), agentsdk.AccessUser)

	agent.RegisterRoute(&agentsdk.Route{
		Method:      "GET",
		Path:        "/",
		Handler:     pages.Home,
		Access:      agentsdk.AccessUser,
		Description: "Default placeholder homepage — replace this once the agent has real routes",
	})
	agent.RegisterRoute(&agentsdk.Route{Method: "GET", Path: "/welcome/word", Handler: pages.Word,
		Access: agentsdk.AccessUser, Description: "Welcome word fragment"})
	agent.RegisterRoute(&agentsdk.Route{Method: "POST", Path: "/welcome/word", Handler: pages.SetWord,
		Access: agentsdk.AccessUser, Description: "Set your welcome word"})

	agent.RegisterStaticAsset(&agentsdk.StaticAsset{
		Name:        views.AppCSSName,
		ContentType: "text/css; charset=utf-8",
		Data:        views.AppCSS,
	})

	// Sol will add RegisterTool, RegisterWebhook, RegisterJob, RegisterConnection calls here.
	return agent
}
